datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CEO
  FINANCE_MANAGER
  SALES_OPERATOR
  AI_OPS_LEAD
  MEMBER
  CLIENT
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  role         UserRole    @default(MEMBER)
  avatarUrl    String?
  phone        String?
  bio          String?
  permissions  String[]    // Granular module access: ["dashboard", "invoices", "clients", ...]
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  invoicesCreated Invoice[]  @relation("InvoiceCreator")
  clientsManaged  Client[]   @relation("ClientAccountManager")
  messagesSent    Message[]  @relation("MessageSender")
  auditLogs       AuditLog[]
}

model Client {
  id              String      @id @default(uuid())
  name            String
  company         String
  email           String      @unique
  phone           String?
  status          String      @default("active") // active, lead, churned
  tier            String      @default("Standard") // Enterprise, Pro, Standard
  assignedToId    String?
  assignedTo      User?       @relation("ClientAccountManager", fields: [assignedToId], references: [id])
  invoices        Invoice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Invoice {
  id              String      @id @default(uuid())
  invoiceNumber   String      @unique
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  creatorId       String
  creator         User        @relation("InvoiceCreator", fields: [creatorId], references: [id])
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD")
  status          String      @default("pending") // paid, pending, overdue, cancelled
  dueDate         DateTime
  items           Json        // Breakdown of AI services, setup fees, retainers
  fileUrl         String?     // PDF stored in Supabase Storage
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Expense {
  id          String      @id @default(uuid())
  title       String
  category    String      // API Credits, Cloud, Salaries, Tooling
  amount      Decimal     @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime    @default(now())
}

model Message {
  id          String      @id @default(uuid())
  channelId   String?     // e.g. "general", "sales", "finance"
  senderId    String
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  content     String
  attachments String[]
  createdAt   DateTime    @default(now())
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  action      String      // "ROLE_CHANGE", "INVOICE_CREATE", "LOGIN"
  details     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
}
